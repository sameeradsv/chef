# Local dev — copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cross-app auth + combined energy (same names as Canopy / Circuit)
NEXT_PUBLIC_CORTEX_URL=http://localhost:7000
NEXT_PUBLIC_CIRCUIT_API_URL=http://localhost:8001
NEXT_PUBLIC_CANOPY_API_URL=http://localhost:8002

# Production (GitHub Pages): repo → Settings → Actions → Variables
# CHEF_API_URL=https://chef-api.vercel.app          → baked as NEXT_PUBLIC_API_URL in CI
# NEXT_PUBLIC_CORTEX_URL=https://cortex-auth.vercel.app
# NEXT_PUBLIC_CIRCUIT_API_URL=https://circuit-api.vercel.app
# NEXT_PUBLIC_CANOPY_API_URL=https://canopy-api.vercel.app
# CORTEX_AUTH_URL on each backend Vercel project (not a frontend var)
