# Local dev — copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cross-app auth + combined energy (same names as Canopy / Circuit)
NEXT_PUBLIC_CORTEX_URL=http://localhost:7000
NEXT_PUBLIC_CIRCUIT_API_URL=http://localhost:8001
NEXT_PUBLIC_CANOPY_API_URL=http://localhost:8002

# Production (GitHub Pages): repo → Settings → Actions → Variables
# CHEF_API_URL=https://chef-api.onrender.com          → baked as NEXT_PUBLIC_API_URL in CI
# NEXT_PUBLIC_CORTEX_URL=https://cortex-auth.onrender.com
# NEXT_PUBLIC_CIRCUIT_API_URL=https://circuit-api.onrender.com
# NEXT_PUBLIC_CANOPY_API_URL=https://canopy-api.onrender.com
# CORTEX_AUTH_URL on each backend Render service (not a frontend var)
