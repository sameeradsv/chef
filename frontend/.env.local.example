# Local dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Shared Cortex Auth Server — enables cross-app accounts (Canopy, Chef, Circuit).
# Leave blank to use Chef-only local accounts.
NEXT_PUBLIC_CORTEX_URL=http://localhost:7000

# Optional: Cross-app energy sync — pre-fills energy/willingness on the Decision page.
# Requires a Cortex account so the same token is accepted by all three backends.
NEXT_PUBLIC_CIRCUIT_URL=http://localhost:8001
NEXT_PUBLIC_CANOPY_URL=http://localhost:8002

# GitHub Pages build (set in repo Settings → Secrets and variables → Actions → Variables)
# CHEF_API_URL=https://chef-api.onrender.com
# NEXT_PUBLIC_CORTEX_URL=https://cortex-auth.onrender.com
# NEXT_PUBLIC_CIRCUIT_URL=https://circuit-api.onrender.com
# NEXT_PUBLIC_CANOPY_URL=https://canopy-api.onrender.com
