# Optional — enables Groq LLM narratives, vision parsing, chat agent, and recipe generation
GROQ_API_KEY=gsk_...

# Optional — override Groq models for recipe generation (defaults: 70b / 8b-instant when fast=true)
# CHEF_RECIPE_MODEL=llama-3.3-70b-versatile
# CHEF_RECIPE_FAST_MODEL=llama-3.1-8b-instant

# Optional — use PostgreSQL instead of SQLite (recommended for production)
# DATABASE_URL=postgresql://user:password@host:5432/chef
# Set false in Vercel after the production schema has been initialized.
# INIT_DB_ON_STARTUP=false

# Optional — comma-separated allowed origins (default covers GitHub Pages; add local dev origins here)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional — Shared Cortex Auth Server URL. Validates cross-app tokens (Canopy, Chef, Circuit).
# Leave blank for Chef-only auth.
# CORTEX_AUTH_URL=http://localhost:7000
# CORTEX_AUTH_URL=https://cortex-auth.vercel.app
